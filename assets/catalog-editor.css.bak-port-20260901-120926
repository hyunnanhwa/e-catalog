/* 전자카달로그 에디터 — 풀스크린 3분할. style.css 토큰과 통일(차콜 #1a1a1a). */
* { box-sizing: border-box; }
:root { --fg:#1f2937; --muted:#6b7280; --line:#e5e7eb; --brand:#1a1a1a; --bg:#f1f5f9; }
html,body.ed-body { margin:0; height:100%; }
body.ed-body { font-family:-apple-system,"Apple SD Gothic Neo",system-ui,sans-serif; color:var(--fg); background:var(--bg); overflow:hidden; }
#editor { height:100vh; display:flex; flex-direction:column; }

/* 상단바 */
.ed-top { height:52px; flex:0 0 auto; background:#fff; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:14px; padding:0 16px; }
.ed-back { color:var(--fg); text-decoration:none; font-size:.9rem; font-weight:600; }
.ed-title { font-weight:700; font-size:.95rem; }
.ed-tools { display:flex; gap:6px; margin-left:10px; }
.ed-tbtn { background:#f3f4f6; border:1px solid var(--line); border-radius:8px; padding:7px 12px; font-size:.85rem; cursor:pointer; }
.ed-tbtn:hover { background:#e9edf2; }
.ed-right-top { margin-left:auto; display:flex; align-items:center; gap:12px; }
.ed-status { font-size:.8rem; color:var(--muted); }
.ed-status.dirty { color:#dc2626; font-weight:700; }
.ed-save { background:var(--brand); color:#fff; border:0; border-radius:8px; padding:8px 18px; font-size:.9rem; cursor:pointer; font-weight:600; }

/* 본문 3분할 */
.ed-main { flex:1; display:flex; min-height:0; }
.ed-slides { width:200px; flex:0 0 auto; background:#fff; border-right:1px solid var(--line); display:flex; flex-direction:column; }
.ed-slides-list { flex:1; overflow-y:auto; padding:10px; }
.ed-slide { position:relative; border:2px solid transparent; border-radius:8px; margin-bottom:10px; cursor:pointer; background:#f8fafc; padding:4px; }
.ed-slide.on { border-color:var(--brand); }
.ed-mini { position:relative; width:100%; overflow:hidden; border-radius:4px; background:#fff; border:1px solid var(--line); container-type:size; }
.ed-mini .el { position:absolute; overflow:hidden; }
.ed-mini .el-text { width:100%; height:100%; overflow:hidden; line-height:1.2; }
.ed-mini .el-img,.ed-mini .el-video { width:100%; height:100%; }
.ed-slide-no { position:absolute; top:6px; left:6px; background:rgba(0,0,0,.55); color:#fff; font-size:.68rem; padding:1px 6px; border-radius:8px; }
.ed-slide-ctl { display:flex; gap:3px; justify-content:center; margin-top:4px; flex-wrap:wrap; }
.ed-slide-ctl button { border:0; background:#eef2f6; border-radius:5px; width:26px; height:22px; cursor:pointer; font-size:.7rem; color:#475569; }
.ed-slide-ctl button:hover { background:#e0e6ed; }
.ed-addslide { flex:0 0 auto; margin:10px; padding:9px; border:1px dashed #cbd5e1; background:#fff; border-radius:8px; cursor:pointer; font-size:.85rem; color:#475569; }

/* 중앙 스테이지 */
.ed-stage { position:relative; flex:1; min-width:0; display:flex; align-items:center; justify-content:center; padding:26px; overflow:hidden; }
.ed-stage-bg { position:absolute; inset:-40px; background-position:center; background-size:cover; background-repeat:no-repeat; z-index:0; display:none; pointer-events:none; }
.ed-canvas-wrap { position:relative; z-index:1; width:100%; max-width:1100px; }
.ed-canvas { position:relative; width:100%; background:#fff; box-shadow:0 12px 40px rgba(0,0,0,.14); border-radius:6px; overflow:hidden; container-type:size; user-select:none; font-family:'Pretendard',-apple-system,"Apple SD Gothic Neo",sans-serif; }
/* 스냅 가이드선 (가장자리/중앙에 딱 붙을 때 표시) */
.ed-vguide,.ed-hguide { position:absolute; background:#ec4899; z-index:9998; pointer-events:none; display:none; }
.ed-vguide { top:0; bottom:0; width:1px; }
.ed-hguide { left:0; right:0; height:1px; }
.ed-mini { font-family:'Pretendard',sans-serif; }
.ed-canvas .el { position:absolute; overflow:visible; cursor:move; }
.ed-canvas .el .el-text { width:100%; height:100%; overflow:hidden; line-height:1.25; word-break:break-word; cursor:move; }
.ed-canvas .el.editing .el-text { cursor:text; outline:2px solid #2563eb; background:rgba(37,99,235,.04); }
.ed-canvas .el-img,.ed-canvas .el-video { width:100%; height:100%; display:block; }
.ed-canvas .el-empty { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#f1f5f9; color:#94a3b8; font-size:.8rem; border:1px dashed #cbd5e1; }
.ed-canvas .el-tab { width:100%; height:100%; display:flex; align-items:center; justify-content:center; border-radius:6px; font-weight:700; }
.ed-canvas .el.sel { outline:1.5px solid #2563eb; }

/* 리사이즈 핸들 */
.rh { position:absolute; width:11px; height:11px; background:#fff; border:1.5px solid #2563eb; border-radius:50%; z-index:9999; }
.rh-nw{left:-6px;top:-6px;cursor:nwse-resize;} .rh-n{left:50%;top:-6px;margin-left:-6px;cursor:ns-resize;}
.rh-ne{right:-6px;top:-6px;cursor:nesw-resize;} .rh-e{right:-6px;top:50%;margin-top:-6px;cursor:ew-resize;}
.rh-se{right:-6px;bottom:-6px;cursor:nwse-resize;} .rh-s{left:50%;bottom:-6px;margin-left:-6px;cursor:ns-resize;}
.rh-sw{left:-6px;bottom:-6px;cursor:nesw-resize;} .rh-w{left:-6px;top:50%;margin-top:-6px;cursor:ew-resize;}
.el-move { display:none; }

/* 우측 속성 */
.ed-props { width:350px; flex:0 0 auto; background:#fff; border-left:1px solid var(--line); overflow-y:auto; padding:16px; }
.pp-empty { color:var(--muted); text-align:center; padding:30px 0; font-size:.85rem; line-height:1.6; }
.pp-h { font-size:.78rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; margin:6px 0 10px; }
.pp-sec { border-top:1px solid var(--line); margin-top:14px; padding-top:12px; }
.pp-row { display:flex; align-items:center; gap:10px; margin-bottom:11px; }
.pp-row label { width:64px; flex:0 0 auto; font-size:.82rem; color:var(--muted); }
.pp-ctl { flex:1; display:flex; align-items:center; gap:6px; }
.pp-ctl input[type=range]{ flex:1; } .pp-ctl select,.pp-ctl input[type=text]{ width:100%; padding:6px 8px; border:1px solid var(--line); border-radius:6px; }
.pp-num { font-size:.78rem; color:var(--muted); min-width:24px; text-align:right; }
.pp-fmt { display:flex; align-items:center; gap:4px; margin-bottom:12px; flex-wrap:wrap; }
.pp-fmt button { width:30px; height:30px; border:1px solid var(--line); background:#fff; border-radius:6px; cursor:pointer; }
.pp-fmt button:hover { background:#f3f4f6; }
.pp-hint { font-size:.68rem; color:#9ca3af; }
.pp-al { width:30px; height:30px; border:1px solid var(--line); background:#fff; border-radius:6px; cursor:pointer; }
.pp-al.on { background:var(--brand); color:#fff; }
.pp-btn { width:100%; padding:9px; border:1px solid var(--line); background:#fff; border-radius:8px; cursor:pointer; margin-top:4px; font-size:.85rem; }
.pp-btn:hover { background:#f3f4f6; }
.pp-grid4 { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.pp-nf { display:flex; align-items:center; gap:6px; }
.pp-nf span { width:16px; font-size:.78rem; color:var(--muted); }
.pp-nf input { width:100%; padding:6px 7px; border:1px solid var(--line); border-radius:6px; font-size:.82rem; }
.pp-order { display:flex; gap:6px; margin-top:12px; }
.pp-order button { flex:1; padding:7px; border:1px solid var(--line); background:#fff; border-radius:7px; cursor:pointer; font-size:.78rem; }
.pp-del { width:100%; margin-top:12px; padding:9px; border:1px solid #fecaca; background:#fff; color:#b91c1c; border-radius:8px; cursor:pointer; font-size:.85rem; }
.pp-del:hover { background:#fef2f2; }

@media (max-width:820px){ .ed-slides{width:108px;} .ed-props{width:210px;} }

/* 이미지 크롭 모달 */
.ed-crop-back { position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:5000; display:flex; align-items:center; justify-content:center; padding:24px; }
.ed-crop { background:#fff; border-radius:12px; max-width:90vw; max-height:90vh; display:flex; flex-direction:column; overflow:hidden; }
.ed-crop-head { padding:14px 18px; border-bottom:1px solid var(--line); font-weight:700; }
.ed-crop-head span { font-weight:400; font-size:.8rem; color:var(--muted); margin-left:8px; }
.ed-crop-body { padding:18px; overflow:auto; display:flex; justify-content:center; background:#0f172a; }
.ed-crop-stage { position:relative; display:inline-block; line-height:0; }
.ed-crop-stage img { display:block; max-width:80vw; max-height:64vh; user-select:none; -webkit-user-drag:none; }
.ed-crop-box { position:absolute; border:2px solid #fff; box-shadow:0 0 0 9999px rgba(0,0,0,.45); cursor:move; }
.ed-crop-box .ch { position:absolute; width:14px; height:14px; background:#fff; border:2px solid #2563eb; border-radius:50%; }
.ch-nw{left:-8px;top:-8px;cursor:nwse-resize;} .ch-ne{right:-8px;top:-8px;cursor:nesw-resize;}
.ch-se{right:-8px;bottom:-8px;cursor:nwse-resize;} .ch-sw{left:-8px;bottom:-8px;cursor:nesw-resize;}
.ed-crop-foot { padding:12px 18px; border-top:1px solid var(--line); display:flex; justify-content:flex-end; align-items:center; gap:10px; }
.ed-crop-foot .pp-btn { width:auto; margin:0; }
.ed-crop-msg { margin-right:auto; font-size:.82rem; color:var(--muted); }

/* 이모지·아이콘 팔레트 */
.pp-picker { border:1px solid var(--line); border-radius:8px; padding:8px; margin-bottom:12px; max-height:200px; overflow-y:auto; background:#fafafa; }
.pk-row { display:flex; flex-wrap:wrap; gap:4px; margin-bottom:6px; }
.pk-row:last-child { margin-bottom:0; }
.pk-emo,.pk-ico { width:30px; height:30px; border:1px solid var(--line); background:#fff; border-radius:6px; cursor:pointer; font-size:1rem; display:flex; align-items:center; justify-content:center; padding:0; color:#374151; }
.pk-emo:hover,.pk-ico:hover { background:#eef2f7; }

/* 텍스트 내 링크: 기본 밑줄·색 제거 → 본문 스타일 상속 */
.ed-canvas .el-text a { color:inherit; text-decoration:none; }

/* 색상박스 */
.ed-canvas .el-box { width:100%; height:100%; }

/* 캐러셀(상장) */
.el-swiper { width:100%; height:100%; }
.el-swiper .swiper-slide { display:flex; align-items:center; justify-content:center; background:#fff; border-radius:6px; overflow:hidden; box-shadow:0 6px 18px rgba(0,0,0,.15); }
.el-swiper .swiper-slide img { max-width:100%; max-height:100%; object-fit:contain; }
.el-swiper[data-eff="coverflow"] .swiper-slide { width:62%; }
/* 속성패널 이미지 관리 */
.cr-imgs { display:flex; flex-direction:column; gap:6px; margin-bottom:8px; max-height:240px; overflow-y:auto; }
.cr-img { display:flex; align-items:center; gap:8px; border:1px solid var(--line); border-radius:8px; padding:5px; }
.cr-img img { width:46px; height:36px; object-fit:contain; background:#f1f5f9; border-radius:4px; flex:0 0 auto; }
.cr-ic { display:flex; gap:3px; margin-left:auto; }
.cr-ic button { width:26px; height:26px; border:1px solid var(--line); background:#fff; border-radius:5px; cursor:pointer; font-size:.7rem; }
.cr-ic .cr-del { color:#b91c1c; border-color:#fecaca; }

/* 캐러셀 — 라벨/네비/dim (뷰어와 동일 스키마) */
.el-swiper .swiper-slide { position:relative; }
.el-swiper .cr-cap { position:absolute; left:0; right:0; bottom:0; padding:5px 8px;
  background:linear-gradient(transparent,rgba(0,0,0,.72)); color:#fff; font-size:clamp(10px,1.6cqw,18px);
  font-weight:600; text-align:center; line-height:1.3; }
.el-swiper[data-lm="active"] .swiper-slide:not(.swiper-slide-active) .cr-cap { display:none; }
.el-swiper[data-dim="1"] .swiper-slide { transition:filter .4s ease; filter:brightness(.45); }
.el-swiper[data-dim="1"] .swiper-slide-active { filter:brightness(1); }
.el-swiper .swiper-button-prev,.el-swiper .swiper-button-next {
  width:34px; height:34px; border-radius:50%; background:var(--navbg,#1a1a1a); color:var(--navcolor,#fff);
  box-shadow:0 3px 10px rgba(0,0,0,.28); margin-top:0; }
.el-swiper .swiper-button-prev::after,.el-swiper .swiper-button-next::after { font-size:14px; font-weight:800; }
.el-swiper[data-navpos="bottom"] .swiper-button-prev { top:auto; bottom:6px; left:calc(50% - 42px); transform:none; }
.el-swiper[data-navpos="bottom"] .swiper-button-next { top:auto; bottom:6px; right:calc(50% - 42px); transform:none; }
.el-swiper[data-navpos="top"] .swiper-button-prev { top:6px; left:calc(50% - 42px); transform:none; }
.el-swiper[data-navpos="top"] .swiper-button-next { top:6px; right:calc(50% - 42px); transform:none; }
/* 속성패널: 이미지 행에 라벨 입력 추가 */
.cr-body { flex:1; display:flex; flex-direction:column; gap:5px; min-width:0; }
.cr-lab { width:100%; border:1px solid var(--line); border-radius:5px; padding:4px 6px; font-size:.78rem; }
.cr-ic { display:flex; gap:3px; }

/* ===== 캐러셀 v2 — 네비/라벨/페이지네이션을 이미지 바깥에 배치 ===== */
.cr-wrap { width:100%; height:100%; display:flex; flex-direction:column; gap:6px; }
.cr-stage { flex:1; min-height:0; display:flex; align-items:center; gap:8px; }
.cr-stage .el-swiper { flex:1; min-width:0; width:auto; height:100%; }
.cr-nav { flex:0 0 auto; width:34px; height:34px; border:0; border-radius:50%; cursor:pointer;
  background:var(--navbg,#1a1a1a); color:var(--navcolor,#fff); display:flex; align-items:center; justify-content:center;
  box-shadow:0 3px 10px rgba(0,0,0,.28); font-size:20px; line-height:1; padding:0; }
.cr-prev::after { content:'‹'; margin-top:-2px; } .cr-next::after { content:'›'; margin-top:-2px; }
.cr-nav.swiper-button-disabled { opacity:.35; cursor:default; }
.cr-foot { flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:5px; }
.cr-head { flex:0 0 auto; display:flex; justify-content:center; gap:44px; }
.cr-bar { display:flex; align-items:center; justify-content:center; gap:12px; }
.cr-capbar { text-align:center; font-weight:600; line-height:1.3; min-height:1.2em; color:#222; font-size:clamp(11px,1.7cqw,20px); }
.cr-wrap .swiper-pagination { position:static; width:auto; }

/* ===== 메일폼(문의) ===== */
.el-form { width:100%; height:100%; overflow:auto; padding:14px 16px; display:flex; flex-direction:column; gap:8px; box-shadow:0 4px 16px rgba(0,0,0,.08); }
.el .el-form { pointer-events:none; }   /* 에디터: 드래그 위해 폼 입력 비활성(속성패널로 편집) */
.ef-title { font-weight:700; font-size:clamp(14px,2.4cqw,26px); color:var(--eflab,#333); }
.ef-row { display:flex; flex-direction:column; gap:3px; }
.ef-lab { font-size:clamp(10px,1.4cqw,15px); font-weight:600; color:var(--eflab,#333); }
.ef-req { color:#e11d48; margin-left:2px; }
.ef-inp { width:100%; border:1px solid #d1d5db; border-radius:8px; padding:7px 10px; font-size:clamp(11px,1.5cqw,16px); font-family:inherit; background:#fff; color:#222; }
textarea.ef-inp { resize:vertical; min-height:52px; }
.ef-hp { position:absolute; left:-9999px; width:1px; height:1px; opacity:0; }
.ef-btn { border:0; border-radius:8px; padding:9px 14px; font-weight:700; cursor:pointer; font-size:clamp(12px,1.6cqw,17px); margin-top:2px; }
.ef-msg { font-size:clamp(10px,1.4cqw,15px); min-height:1.1em; text-align:center; }
/* 속성패널 — 필드 편집 */
.fm-flds { display:flex; flex-direction:column; gap:8px; }
.fm-fld { display:grid; grid-template-columns:1fr auto; gap:5px 8px; border:1px solid var(--line); border-radius:8px; padding:7px 8px; align-items:center; }
.fm-on { font-weight:600; font-size:.82rem; display:flex; align-items:center; gap:5px; }
.fm-req { font-size:.8rem; display:flex; align-items:center; gap:4px; justify-self:end; }
.fm-lab,.fm-ph { grid-column:1 / -1; border:1px solid var(--line); border-radius:5px; padding:4px 6px; font-size:.78rem; }
.pp-hint { font-size:.72rem; color:#888; margin:-2px 0 4px; }

/* 카달로그 비율 입력 (가로:세로) */
.pp-ar { display:flex; align-items:center; gap:6px; }
.pp-ar input[type="number"] { width:64px; border:1px solid var(--line); border-radius:6px; padding:6px 8px; font-size:.9rem; text-align:center; }
.pp-ar-x { font-weight:700; color:var(--muted); }
.pp-btn.sm { width:auto; margin:0 0 0 auto; padding:6px 10px; font-size:.78rem; }

/* 정렬 가이드 오버레이 (편집 전용) */
.ed-guides { display:none; position:absolute; inset:0; pointer-events:none; z-index:9990; }
.ed-canvas.show-guides .ed-guides { display:block; }
.ed-guides i { position:absolute; background:rgba(37,99,235,.28); }
.ed-guides .gv { top:0; bottom:0; width:1px; }
.ed-guides .gh { left:0; right:0; height:1px; }
.ed-guides .center { background:rgba(37,99,235,.6); }
.ed-tbtn-toggle.on { background:#2563eb; color:#fff; border-color:#2563eb; }
.pp-ar-u { color:var(--muted); font-size:.82rem; }

/* 회전 각도 숫자 입력 */
.pp-numin { width:58px; border:1px solid var(--line); border-radius:6px; padding:5px 6px; font-size:.82rem; text-align:center; margin-left:6px; }
/* 포토샵식 드래그 가이드 */
.ed-cguides { display:none; position:absolute; inset:0; pointer-events:none; z-index:9992; }
.ed-canvas.show-guides .ed-cguides { display:block; }
.ed-cguide { position:absolute; pointer-events:auto; }
.ed-cguide.cg-v { top:0; bottom:0; width:1px; background:#e11d8f; cursor:ew-resize; }
.ed-cguide.cg-h { left:0; right:0; height:1px; background:#e11d8f; cursor:ns-resize; }
.ed-cguide.cg-v::before { content:''; position:absolute; top:0; bottom:0; left:-4px; width:9px; }
.ed-cguide.cg-h::before { content:''; position:absolute; left:0; right:0; top:-4px; height:9px; }
.ed-guide-tools { display:none; gap:6px; }
.ed-canvas.show-guides ~ * .ed-guide-tools, .show-guides-tools .ed-guide-tools { display:inline-flex; }

/* 컨텐츠 잠금 버튼 (호버 시 표시, 잠금 시 상시) */
.ed-canvas .el-lock { position:absolute; top:4px; right:4px; z-index:10000; width:24px; height:24px; border:0; border-radius:6px; background:rgba(255,255,255,.92); box-shadow:0 1px 4px rgba(0,0,0,.25); cursor:pointer; font-size:12px; line-height:1; display:none; align-items:center; justify-content:center; padding:0; }
.ed-canvas .el:hover .el-lock, .ed-canvas .el.locked .el-lock { display:flex; }
.ed-canvas .el-lock.on { background:#f59e0b; }
.ed-canvas .el.locked { cursor:default; }
.ed-canvas .el.locked.sel { outline:1.5px dashed #f59e0b; }

/* 선(line) 요소 — 요소 박스 세로 중앙에 그려지고 회전으로 세로/대각선 */
.ed-canvas .el-line { position:absolute; left:0; right:0; top:50%; height:0; transform-origin:center center; }

/* 다중 선택 — 마퀴 / 그룹 박스·핸들 */
.ed-marquee { position:absolute; z-index:10000; border:1px solid #2563eb; background:rgba(37,99,235,.12); pointer-events:none; }
.ed-groupbox { position:absolute; z-index:10001; border:1.5px dashed #2563eb; background:transparent; pointer-events:none; }
.ed-groupbox .grh { position:absolute; width:11px; height:11px; background:#fff; border:1.5px solid #2563eb; border-radius:2px; pointer-events:auto; }
.grh-nw{left:-6px;top:-6px;cursor:nwse-resize;} .grh-n{left:50%;top:-6px;margin-left:-6px;cursor:ns-resize;}
.grh-ne{right:-6px;top:-6px;cursor:nesw-resize;} .grh-e{right:-6px;top:50%;margin-top:-6px;cursor:ew-resize;}
.grh-se{right:-6px;bottom:-6px;cursor:nwse-resize;} .grh-s{left:50%;bottom:-6px;margin-left:-6px;cursor:ns-resize;}
.grh-sw{left:-6px;bottom:-6px;cursor:nesw-resize;} .grh-w{left:-6px;top:50%;margin-top:-6px;cursor:ew-resize;}

/* 캐러셀 슬라이드 v3 — 흰 배경 제거(투명) + 이미지맞춤/노출개수 */
.el-swiper .swiper-slide { background:transparent; overflow:visible; box-shadow:none; display:flex; align-items:center; justify-content:center; }
.el-swiper .swiper-slide img { max-width:100%; max-height:100%; object-fit:contain; border-radius:6px; box-shadow:0 6px 18px rgba(0,0,0,.18); display:block; }
.el-swiper[data-fit="fit"] .swiper-slide { width:auto !important; }
.el-swiper[data-fit="fit"] .swiper-slide img { height:100%; width:auto; max-width:none; max-height:100%; }
.el-swiper[data-fit="cover"] .swiper-slide { overflow:hidden; border-radius:6px; }
.el-swiper[data-fit="cover"] .swiper-slide img { width:100%; height:100%; object-fit:cover; box-shadow:none; }

/* 개별 입력칸(field) / 전송 버튼(submit) — 각각 이동 요소 */
/* ⚠️ .el 래퍼도 class "el el-field/el-submit" 이므로 반드시 자손선택자(.el >)로 내부 콘텐츠만 대상 — 래퍼 pointer-events 살려야 클릭/이동/리사이즈 됨 */
.ed-canvas .el > .el-field { width:100%; height:100%; display:flex; flex-direction:column; gap:5px; }
.ed-canvas .el > .el-field .ef-lab { font-weight:600; font-size:.92em; }
.ed-canvas .el > .el-field .ef-req { color:#e11d48; }
.ed-canvas .el > .el-field .ef-inp { flex:1; width:100%; min-height:0; border:1px solid #d1d5db; padding:6px 10px; font:inherit; color:inherit; box-sizing:border-box; }
.ed-canvas .el > .el-field textarea.ef-inp { resize:none; }
.ed-canvas .el > .el-submit { width:100%; height:100%; border:0; cursor:pointer; font-weight:700; }
.ed-canvas .el > .el-field, .ed-canvas .el > .el-field *, .ed-canvas .el > .el-submit { pointer-events:none; }
.fm-add { display:flex; flex-wrap:wrap; gap:6px; }
.fm-add .pp-btn.sm { width:auto; margin:0; flex:0 0 auto; padding:6px 11px; }

/* 색상 선택기 + hex 코드 입력 */
.pp-ctl input[type="color"] { width:38px; height:30px; flex:0 0 auto; padding:0; border:1px solid var(--line); border-radius:6px; background:#fff; cursor:pointer; }
.pp-hex { width:80px; flex:0 0 auto; border:1px solid var(--line); border-radius:6px; padding:5px 7px; font-size:.78rem; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }
